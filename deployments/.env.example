# Database
# IMPORTANTE: copia este archivo a .env y SUSTITUYE los valores con credenciales reales.
# docker compose fallará si estas variables no están definidas (se acabaron los defaults).
DATABASE_URL=postgresql://mcp:CHANGE_ME_DB_PASSWORD@postgres:5432/knowledge
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Storage (RustFS)
RUSTFS_ENDPOINT=rustfs:9000
RUSTFS_ACCESS_KEY_ID=CHANGE_ME_ACCESS_KEY
RUSTFS_SECRET_ACCESS_KEY=CHANGE_ME_SECRET_KEY

# Web Search (via Nginx reverse proxy)
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=CHANGE_ME_SEARXNG_SECRET_LONG_RANDOM

# Web Scraping (via Nginx reverse proxy)
CRAWL4AI_URL=http://crawl4ai:11235
CRAWL4AI_TOKEN=CHANGE_ME_CRAWL4AI_TOKEN

# Upload API key (protege /upload; vacío = endpoint sin auth)
MCP_UPLOAD_API_KEY=

# Bearer token para /mcp (vacío = endpoint sin auth; recomendar generarlo en producción)
MCP_API_KEY=

# textFlow (optional — if empty, agents skip notification)
TEXTFLOW_ENDPOINT=
TEXTFLOW_WEBHOOK_URL=
TEXTFLOW_WEBHOOK_SECRET=

# Multi-tenant
TENANT_ID=default

# Nginx — puerto externo
EXTERNAL_PORT=80